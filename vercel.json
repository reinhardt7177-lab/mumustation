{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/sosu",
      "destination": "/sosu/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sosu/",
      "destination": "https://sosu-dungeon.vercel.app/"
    },
    {
      "source": "/sosu/:path*",
      "destination": "https://sosu-dungeon.vercel.app/:path*"
    }
  ]
}
