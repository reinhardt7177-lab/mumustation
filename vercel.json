{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/sosuworld/", "permanent": false },
    { "source": "/sosuworld", "destination": "/sosuworld/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/sosuworld/", "destination": "https://sosu-dungeon.vercel.app/" },
    { "source": "/sosuworld/:path*", "destination": "https://sosu-dungeon.vercel.app/:path*" }
  ]
}
